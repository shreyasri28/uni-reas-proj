# Frontend (Vite)
VITE_API_URL=http://localhost:3000/api
VITE_USE_MOCK_DATA=false

# Backend (loaded by server/src/index.js from the project-root .env.local)
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=uni_reas_user
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=uni_reas
DB_CONNECTION_LIMIT=10

# Brevo SMTP (SMTP login and SMTP key, not your Brevo account password)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM=Uni-Reas <verified-sender@your-domain.com>

# Optional: leave blank to allow any valid email address
ALLOWED_EMAIL_DOMAIN=
